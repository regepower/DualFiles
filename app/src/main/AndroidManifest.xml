<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network storages (FTP, WebDAV) and finding them in the local network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Hands APK files to Android's package installer (asked for once, only when an APK is opened). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- A file manager needs all-files access; granted by the user in system settings. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Lets the app look up which app opens a file type (icon next to the file). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with DualFiles" for ZIP and 7z archives: shown as a tree in the source list. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-7z-compressed" />
            </intent-filter>
        </activity>
        <!-- Text/hex viewer, also offered to other apps for text and unknown file types (not for pictures, videos, PDF). -->
        <activity
            android:name=".ViewerActivity"
            android:exported="true"
            android:label="@string/viewer_label">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/x-sh" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/x-subrip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <!-- Receives the app picked in the chooser so it is remembered per file type. -->
        <receiver
            android:name=".ChooserReceiver"
            android:exported="false" />
        <provider
            android:name=".FileShare"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Build day (ISO date) from build.gradle.kts. -->
        <meta-data
            android:name="build_date"
            android:value="${buildDate}" />
    </application>
</manifest>
